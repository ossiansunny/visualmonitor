<?php
error_reporting(E_ALL & ~E_WARNING);

///------------------------------------------------------------
///------- Windows Disk------OIDŒÅ’è--------------------
///------------------------------------------------------------
function windiskload($host,$community,&$data) {
  $output=array();
  $result=array();
  $snmpcmd="snmpget -v1 -c{$community} {$host} .1.3.6.1.2.1.25.2.3.1.5.1";
  exec($snmpcmd,$output,$result);
  if($result==1){
    return 1;
  }
  $outArr=explode(':',$output[0]);
  $ssize=ltrim($outArr[3]);
  //echo 'size:'.$ssize.PHP_EOL;
  //var_dump($output);
  $output=array();
  $result=array();  
  $snmpcmd="snmpget -v1 -c{$community} {$host} .1.3.6.1.2.1.25.2.3.1.6.1";
  exec($snmpcmd,$output,$result);
  if($result==1){
    return 1;
  }
  $outArr=explode(':',$output[0]);
  $sused=ltrim($outArr[3]);
  //echo 'used:'.$sused.PHP_EOL;
  //var_dump($output);
  if(intval($sused) < intval($ssize)){
    $ritsu=intval($sused) / intval($ssize) * 100;
    //echo strval(round($ritsu)). ' percent'.PHP_EOLa
    $data=strval(round($ritsu));
    return 0;
  }else{
    //echo 'error'.PHP_EOL;
    return 1;
  }
}

///-------------------------------------------------------------
///------- Windows RAM-------OID Index‚É‚æ‚è•Ï‰»---------------------
///-------------------------------------------------------------
function winramload($host,$community,&$data) {
  $snmpcmd="snmpwalk -v1 -c{$community} {$host} .1.3.6.1.2.1.25.2.3.1.3";
  $output=array();
  $result=array();
  exec($snmpcmd,$output,$result);
  if($result==1){
    return 1;
  }
  $oldram="0";
  foreach($output as $record){
    $reg=preg_match('/STRING: Physical Memory$/',$record);
    if($reg==1){
      //echo $record.PHP_EOL;
      $sval=explode('.',$record);
      $slval=$sval[1];
      $val=explode(' ',$slval);
      $oidram=$val[0];
    
      //echo 'keyoid:'.$oidram.PHP_EOL;
    }
  }
  if($oidram=="0"){
    $data=0;
    return 1;
  } else {
  ///---------windows size------------------------------------------
    $oidsize=".1.3.6.1.2.1.25.2.3.1.5.".$oidram;
    $snmpcmd="snmpget -v1 -c{$community} {$host} {$oidsize}";
    $output=array();
    $result=array();
    exec($snmpcmd,$output,$result);
   //var_dump($output);;
    if($result==1){
      return 1;
    }
    $dsv=explode(':',$output[0]);
    $dsvs=$dsv[3];
    //echo 'size:'.$dsvs.PHP_EOL;
  ///---------windows used------------------------------------------
    $oidused=".1.3.6.1.2.1.25.2.3.1.6.".$oidram;
    $snmpcmd="snmpget -v1 -c{$community} {$host} {$oidused}";
    $output=array();
    $result=array();
    exec($snmpcmd,$output,$result);
  //var_dump($output);
    if($result==1){
      return 1;
    }
    $dsv=explode(':',$output[0]);
    $dsvu=$dsv[3];
    //echo 'used:'.$dsvu.PHP_EOL;
  ///----------windows ram load -------------------------------------------------------------
    if(intval($dsvu) < intval($dsvs)) {
      $dp = intval($dsvu) / intval($dsvs) * 100;
      $data=strval(round($dp));
      //echo 'ram load:'.$data.'percent'.PHP_EOL;
      return 0;
    } else {
      $dp = 0;
      return 1;
    }
  }
}
///---------- Unix Disk--OID@Index‚É‚æ‚è•Ï‰»------------------------
///------------------------------------------------------------
function unixdiskload($host,$community,&$data) {
  $snmpcmd="snmpwalk -v1 -c{$community} {$host} .1.3.6.1.2.1.25.2.3.1.3";
  $output=array();
  $result=array();
  exec($snmpcmd,$output,$result);
  if($result==1){
    return 1;
  }
  $olddisk="0";
  foreach($output as $record){
    $reg=preg_match('/STRING: \/$/',$record);
    if($reg==1){
      //echo $record.PHP_EOL;
      $sval=explode('.',$record);
      $slval=$sval[1];
      $val=explode(' ',$slval);;
      $oiddisk=$val[0];
      //echo 'oiddisk:'.$oiddisk.PHP_EOL;
    }
  }
  if($oiddisk=="0"){
    $data=0;
    return 1;
  } else {
  ///---------unix size------------------------------------------
    $oidsize=".1.3.6.1.2.1.25.2.3.1.5.".$oiddisk;
    $snmpcmd="snmpget -v1 -c{$community} {$host} {$oidsize}";
    $output=array();
    $result=array();
    exec($snmpcmd,$output,$result);
   //var_dump($output);;
    if($result==1){
      return 1;
    }
    $dsv=explode(':',$output[0]);
    $dsvs=$dsv[3];
    //echo 'size:'.$dsvs.PHP_EOL;
  ///---------unix used------------------------------------------
    $oidused=".1.3.6.1.2.1.25.2.3.1.6.".$oiddisk;
    $snmpcmd="snmpget -v1 -c{$community} {$host} {$oidused}";
    $output=array();
    $result=array();
    exec($snmpcmd,$output,$result);
  //var_dump($output);
    if($result==1){
      return 1;
    }
    $dsv=explode(':',$output[0]);
    $dsvu=$dsv[3];
    //echo 'used:'.$dsvu.PHP_EOL;
  ///----------unix disk load -------------------------------------------------------------
    if(intval($dsvu) < intval($dsvs)) {
      $dp = intval($dsvu) / intval($dsvs) * 100;
      $data=strval(round($dp));
      //echo 'disk load:'.$data.'percent'.PHP_EOL;
      return 0;
    } else {
      $dp = 0;
      return 1;
    }
  }
}

